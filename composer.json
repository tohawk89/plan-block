{
    "name": "tohawk89/plan-block",
    "description": "Notion-style block system for Laravel: flexible itineraries, backup plans and linked checklists. Works with Blade, Livewire or any JS framework.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "blocks",
        "itinerary",
        "planner",
        "checklist",
        "livewire"
    ],
    "homepage": "https://github.com/tohawk89/plan-block",
    "support": {
        "issues": "https://github.com/tohawk89/plan-block/issues",
        "source": "https://github.com/tohawk89/plan-block"
    },
    "authors": [
        {
            "name": "Nazar"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/reverb": "^1.6",
        "livewire/livewire": "^3.8.3|^4.4.8",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "livewire/livewire": "Required for <livewire:plan-block> (^3.8.3|^4.4.8)."
    },
    "autoload": {
        "psr-4": {
            "Tohawk89\\PlanBlock\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tohawk89\\PlanBlock\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tohawk89\\PlanBlock\\PlanBlockServiceProvider"
            ],
            "aliases": {
                "PlanBlock": "Tohawk89\\PlanBlock\\Facades\\PlanBlock"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
